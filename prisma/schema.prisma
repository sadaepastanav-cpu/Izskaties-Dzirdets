generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(HOST)
  shows        Show[]
  createdAt    DateTime @default(now())
}

enum Role {
  SUPERADMIN
  HOST
}

model Show {
  id        String        @id @default(cuid())
  title     String
  ownerId   String
  owner     User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions  ShowVersion[]
  sessions  Session[]
  createdAt DateTime      @default(now())
}

model ShowVersion {
  id        String    @id @default(cuid())
  showId    String
  show      Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  scenes    Json      // Glabā visu slaida/scēnas konfigurāciju, izkārtojumu un mediju saites
  version   Int       @default(1)
  sessions  Session[]
  createdAt DateTime  @default(now())

  @@index([showId])
}

model Session {
  id             String        @id @default(cuid())
  pin            String        @unique
  status         SessionStatus @default(READY)
  showId         String
  show           Show          @relation(fields: [showId], references: [id])
  versionId      String
  version        ShowVersion   @relation(fields: [versionId], references: [id])
  
  currentSceneId String?       
  lastState      Json?         // SNAPSHOT: Glabā tekošo spēles stāvokli drošai atjaunošanai pēc servera vai tīkla kļūmes

  participants   Participant[]
  eventLogs      EventLog[]
  votes          Vote[]
  answers        Answer[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([pin])
  @@index([status])
}

enum SessionStatus {
  READY
  LIVE
  PAUSED
  FINISHED
}

model Participant {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name       String
  token      String   @unique // Piesaiste dalībnieka sesijai/reconnect drošībai
  isOnline   Boolean  @default(true)
  
  // Punktu uzskaites lauki
  score      Int      @default(0) // Kopejais punktu skaits (saderibai)
  roundScore Int      @default(0) // Punkti tekošajā kārtā / slaidā
  totalScore Int      @default(0) // Akumulētie punkti visā spēlē
  
  votes      Vote[]
  answers    Answer[]
  
  joinedAt   DateTime @default(now())

  @@index([sessionId])
  @@index([token])
}

model Vote {
  id            String      @id @default(cuid())
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sceneId       String
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  optionId      String      
  createdAt     DateTime    @default(now())

  @@index([sessionId, sceneId])
  @@index([participantId])
}

model Answer {
  id             String      @id @default(cuid())
  sessionId      String
  session        Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sceneId        String
  participantId  String
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  answerBody     String
  isCorrect      Boolean
  pointsEarned   Int
  responseTimeMs Int
  createdAt      DateTime    @default(now())

  @@index([sessionId, sceneId])
  @@index([participantId])
}

model EventLog {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      String   // piem., "SCENE_CHANGE", "ANSWER_SUBMITTED", "TIMER_PAUSED"
  payload   Json
  createdAt DateTime @default(now())

  @@index([sessionId])
}